# Copy to .env.local and fill in real values. Never commit .env.local (only
# this .env.example may live in git - see ATTACK_CHECKLIST C-02).

# Supabase (project settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-anon-or-publishable-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key        # server-only, never NEXT_PUBLIC_, never git

# Direct database URL (SQL files, psql, verify scripts) - server-only
DATABASE_URL=postgresql://postgres:password@host:5432/postgres

# Clerk (dashboard -> API keys)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxx
CLERK_SECRET_KEY=sk_test_xxx                            # server-only, never git
